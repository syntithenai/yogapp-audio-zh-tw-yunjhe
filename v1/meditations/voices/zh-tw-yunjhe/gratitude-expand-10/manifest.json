{
  "id": "gratitude-expand-10",
  "voiceId": "zh-tw-yunjhe",
  "edgeVoice": "zh-TW-YunJheNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 194,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "需要時間到達。",
      "file": "c001.ogg",
      "durationSec": 4.104
    },
    {
      "index": 2,
      "text": "在支撐下坐下或躺下。",
      "file": "c002.ogg",
      "durationSec": 4.992
    },
    {
      "index": 3,
      "text": "如果感覺安全，請閉上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.976
    },
    {
      "index": 4,
      "text": "感受與地面的接觸。",
      "file": "c004.ogg",
      "durationSec": 4.632
    },
    {
      "index": 5,
      "text": "緩慢吸氣。",
      "file": "c005.ogg",
      "durationSec": 3.528
    },
    {
      "index": 6,
      "text": "呼氣時間更長。",
      "file": "c006.ogg",
      "durationSec": 4.128
    },
    {
      "index": 7,
      "text": "[暫停：27]",
      "file": "c007.ogg",
      "durationSec": 4.392
    },
    {
      "index": 8,
      "text": "再次。",
      "file": "c008.ogg",
      "durationSec": 3.096
    },
    {
      "index": 9,
      "text": "[暫停：27]",
      "file": "c009.ogg",
      "durationSec": 4.392
    },
    {
      "index": 10,
      "text": "讓肩膀下垂。",
      "file": "c010.ogg",
      "durationSec": 3.936
    },
    {
      "index": 11,
      "text": "讓腹部變軟。",
      "file": "c011.ogg",
      "durationSec": 3.6
    },
    {
      "index": 12,
      "text": "[暫停：34]",
      "file": "c012.ogg",
      "durationSec": 4.728
    },
    {
      "index": 13,
      "text": "從一件小的具體物品開始。",
      "file": "c013.ogg",
      "durationSec": 5.304
    },
    {
      "index": 14,
      "text": "握住它。謝謝它。",
      "file": "c014.ogg",
      "durationSec": 6.024
    },
    {
      "index": 15,
      "text": "[停頓：40]",
      "file": "c015.ogg",
      "durationSec": 4.44
    },
    {
      "index": 16,
      "text": "一秒鐘。一個人，一個地方，或者一個舒適的地方。",
      "file": "c016.ogg",
      "durationSec": 10.008
    },
    {
      "index": 17,
      "text": "謝謝。",
      "file": "c017.ogg",
      "durationSec": 3.168
    },
    {
      "index": 18,
      "text": "[停頓：40]",
      "file": "c018.ogg",
      "durationSec": 4.44
    },
    {
      "index": 19,
      "text": "第三個。今天，你身體上的一些東西起作用了。",
      "file": "c019.ogg",
      "durationSec": 9.936
    },
    {
      "index": 20,
      "text": "謝謝。",
      "file": "c020.ogg",
      "durationSec": 3.168
    },
    {
      "index": 21,
      "text": "[停頓：40]",
      "file": "c021.ogg",
      "durationSec": 4.44
    },
    {
      "index": 22,
      "text": "擴大到那些曾經友善的人，即使是短暫的。",
      "file": "c022.ogg",
      "durationSec": 7.512
    },
    {
      "index": 23,
      "text": "[暫停：54]",
      "file": "c023.ogg",
      "durationSec": 4.704
    },
    {
      "index": 24,
      "text": "擴大到你所在的地方。庇護所。空氣。地面。",
      "file": "c024.ogg",
      "durationSec": 13.176
    },
    {
      "index": 25,
      "text": "[暫停：54]",
      "file": "c025.ogg",
      "durationSec": 4.704
    },
    {
      "index": 26,
      "text": "如果感恩感覺很難，那就感謝自己表現出來的努力。",
      "file": "c026.ogg",
      "durationSec": 8.232
    },
    {
      "index": 27,
      "text": "這很重要。",
      "file": "c027.ogg",
      "durationSec": 3.456
    },
    {
      "index": 28,
      "text": "[停頓：40]",
      "file": "c028.ogg",
      "durationSec": 4.44
    },
    {
      "index": 29,
      "text": "在出現的任何溫暖中休息。",
      "file": "c029.ogg",
      "durationSec": 5.304
    },
    {
      "index": 30,
      "text": "或者安息在意圖本身。",
      "file": "c030.ogg",
      "durationSec": 4.872
    },
    {
      "index": 31,
      "text": "[暫停：90]",
      "file": "c031.ogg",
      "durationSec": 4.608
    },
    {
      "index": 32,
      "text": "[停頓：40]",
      "file": "c032.ogg",
      "durationSec": 4.44
    },
    {
      "index": 33,
      "text": "開始加深呼吸。",
      "file": "c033.ogg",
      "durationSec": 4.056
    },
    {
      "index": 34,
      "text": "再次感受一下房間。",
      "file": "c034.ogg",
      "durationSec": 4.296
    },
    {
      "index": 35,
      "text": "擺動手指和腳趾。",
      "file": "c035.ogg",
      "durationSec": 4.44
    },
    {
      "index": 36,
      "text": "準備好後，睜開眼睛。",
      "file": "c036.ogg",
      "durationSec": 5.304
    },
    {
      "index": 37,
      "text": "慢慢地進入接下來的事情。",
      "file": "c037.ogg",
      "durationSec": 5.04
    }
  ]
}
