{
  "id": "lakeside-dawn-5",
  "voiceId": "zh-tw-yunjhe",
  "edgeVoice": "zh-TW-YunJheNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 363,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "找一個舒適的座位，或者如果感覺好一點的話就躺下來。",
      "file": "c001.ogg",
      "durationSec": 8.856
    },
    {
      "index": 2,
      "text": "讓你的雙手休息一下。",
      "file": "c002.ogg",
      "durationSec": 4.56
    },
    {
      "index": 3,
      "text": "讓你的眼睛閉上，或者軟化你的目光。",
      "file": "c003.ogg",
      "durationSec": 6.552
    },
    {
      "index": 4,
      "text": "注意你所承受的身體重量。",
      "file": "c004.ogg",
      "durationSec": 5.376
    },
    {
      "index": 5,
      "text": "透過鼻子緩慢吸氣。",
      "file": "c005.ogg",
      "durationSec": 4.56
    },
    {
      "index": 6,
      "text": "並且呼氣時間更長、更輕鬆。",
      "file": "c006.ogg",
      "durationSec": 5.928
    },
    {
      "index": 7,
      "text": "再次。輕輕吸氣。",
      "file": "c007.ogg",
      "durationSec": 6.6
    },
    {
      "index": 8,
      "text": "輕輕呼氣。",
      "file": "c008.ogg",
      "durationSec": 3.672
    },
    {
      "index": 9,
      "text": "如果思緒遊離，那也沒關係。回到呼吸。",
      "file": "c009.ogg",
      "durationSec": 9.024
    },
    {
      "index": 10,
      "text": "想象一下自己在黎明時分站在平靜的湖邊。",
      "file": "c010.ogg",
      "durationSec": 7.272
    },
    {
      "index": 11,
      "text": "水面托起淡銀色的天空。",
      "file": "c011.ogg",
      "durationSec": 4.968
    },
    {
      "index": 12,
      "text": "涼爽的空氣拂過你的臉頰，帶來清新的感覺。",
      "file": "c012.ogg",
      "durationSec": 7.824
    },
    {
      "index": 13,
      "text": "柔軟的陽光開始溫暖你的肩膀。",
      "file": "c013.ogg",
      "durationSec": 5.76
    },
    {
      "index": 14,
      "text": "感覺溫暖慢慢地蔓延到你的背上。",
      "file": "c014.ogg",
      "durationSec": 5.712
    },
    {
      "index": 15,
      "text": "你走近了一步。柔軟的沙子踩在你的腳下。",
      "file": "c015.ogg",
      "durationSec": 8.928
    },
    {
      "index": 16,
      "text": "將指尖浸入水中。涼爽的。清除。",
      "file": "c016.ogg",
      "durationSec": 10.464
    },
    {
      "index": 17,
      "text": "漣漪向外傳播並消失。",
      "file": "c017.ogg",
      "durationSec": 4.848
    },
    {
      "index": 18,
      "text": "微風中帶著淡淡的水草和早晨的味道。",
      "file": "c018.ogg",
      "durationSec": 6.72
    },
    {
      "index": 19,
      "text": "聽著。幾乎什麼都沒有。一隻遙遠的鳥。你自己的呼吸。",
      "file": "c019.ogg",
      "durationSec": 13.992
    },
    {
      "index": 20,
      "text": "坐在一塊光滑的石頭上，被冉冉升起的光線加熱得剛剛好。",
      "file": "c020.ogg",
      "durationSec": 8.904
    },
    {
      "index": 21,
      "text": "感受腳下石頭安靜的熱量。",
      "file": "c021.ogg",
      "durationSec": 5.232
    },
    {
      "index": 22,
      "text": "感受進入肺部的新鮮空氣。",
      "file": "c022.ogg",
      "durationSec": 5.352
    },
    {
      "index": 23,
      "text": "湖水呈現出柔和的粉紅色和金色。",
      "file": "c023.ogg",
      "durationSec": 6.504
    },
    {
      "index": 24,
      "text": "你會看到光線在表面移動，就像緩慢的呼吸一樣。",
      "file": "c024.ogg",
      "durationSec": 8.28
    },
    {
      "index": 25,
      "text": "一條魚升起，環變寬，然後鏡子又回來了。",
      "file": "c025.ogg",
      "durationSec": 7.704
    },
    {
      "index": 26,
      "text": "溫暖在你閉上的眼瞼上。",
      "file": "c026.ogg",
      "durationSec": 5.136
    },
    {
      "index": 27,
      "text": "手背涼涼的。",
      "file": "c027.ogg",
      "durationSec": 3.84
    },
    {
      "index": 28,
      "text": "遠處的某個地方，一根船繩在木頭上發出滴答聲。",
      "file": "c028.ogg",
      "durationSec": 7.992
    },
    {
      "index": 29,
      "text": "然後又是一片寂靜，寬廣而友善。",
      "file": "c029.ogg",
      "durationSec": 6.792
    },
    {
      "index": 30,
      "text": "吸入清晨的涼爽。呼氣到開放水域。",
      "file": "c030.ogg",
      "durationSec": 8.808
    },
    {
      "index": 31,
      "text": "平靜就像薄霧從水中升起的方式一樣平靜——輕輕地、完全地。",
      "file": "c031.ogg",
      "durationSec": 10.248
    },
    {
      "index": 32,
      "text": "你可以在這片安靜中佔據一席之地。",
      "file": "c032.ogg",
      "durationSec": 6.432
    },
    {
      "index": 33,
      "text": "又呼吸了一口黎明的味道。",
      "file": "c033.ogg",
      "durationSec": 4.896
    },
    {
      "index": 34,
      "text": "再看看水面上銀色的光路。",
      "file": "c034.ogg",
      "durationSec": 5.472
    },
    {
      "index": 35,
      "text": "用溫柔的目光追隨它，走向遠方的海岸。",
      "file": "c035.ogg",
      "durationSec": 7.032
    },
    {
      "index": 36,
      "text": "那邊的樹木因遠處和晨霧而呈藍色。",
      "file": "c036.ogg",
      "durationSec": 6.408
    },
    {
      "index": 37,
      "text": "隨著太陽的升起，你的肩膀上漸漸變得溫暖起來。",
      "file": "c037.ogg",
      "durationSec": 8.688
    },
    {
      "index": 38,
      "text": "微風保持清新——湖水吹來，乾淨。",
      "file": "c038.ogg",
      "durationSec": 7.176
    },
    {
      "index": 39,
      "text": "讓清新的感覺沖洗心靈，就像光線沖洗表面一樣。",
      "file": "c039.ogg",
      "durationSec": 8.256
    },
    {
      "index": 40,
      "text": "一起再坐三口溫暖和涼爽的空氣。",
      "file": "c040.ogg",
      "durationSec": 6.192
    },
    {
      "index": 41,
      "text": "現在獨自在呼吸中休息一會兒。",
      "file": "c041.ogg",
      "durationSec": 5.856
    },
    {
      "index": 42,
      "text": "慢慢吸氣。",
      "file": "c042.ogg",
      "durationSec": 3.432
    },
    {
      "index": 43,
      "text": "慢慢呼氣。",
      "file": "c043.ogg",
      "durationSec": 3.456
    },
    {
      "index": 44,
      "text": "吸氣。",
      "file": "c044.ogg",
      "durationSec": 3.12
    },
    {
      "index": 45,
      "text": "呼氣。",
      "file": "c045.ogg",
      "durationSec": 3.072
    },
    {
      "index": 46,
      "text": "身體哪裡溫暖，哪裡就感覺溫暖。",
      "file": "c046.ogg",
      "durationSec": 6.408
    },
    {
      "index": 47,
      "text": "空氣涼爽的地方都會感到涼爽。",
      "file": "c047.ogg",
      "durationSec": 5.808
    },
    {
      "index": 48,
      "text": "吸氣。",
      "file": "c048.ogg",
      "durationSec": 3.12
    },
    {
      "index": 49,
      "text": "呼氣。",
      "file": "c049.ogg",
      "durationSec": 3.072
    },
    {
      "index": 50,
      "text": "無處可去。沒什麼可修復的。",
      "file": "c050.ogg",
      "durationSec": 7.608
    },
    {
      "index": 51,
      "text": "吸氣。",
      "file": "c051.ogg",
      "durationSec": 3.12
    },
    {
      "index": 52,
      "text": "呼氣。",
      "file": "c052.ogg",
      "durationSec": 3.072
    },
    {
      "index": 53,
      "text": "在這裡休息一下，安靜地呼吸幾口氣。",
      "file": "c053.ogg",
      "durationSec": 6.84
    },
    {
      "index": 54,
      "text": "要知道你可以隨時回到這個地方。",
      "file": "c054.ogg",
      "durationSec": 5.616
    },
    {
      "index": 55,
      "text": "當你準備好後，加深呼吸。",
      "file": "c055.ogg",
      "durationSec": 5.544
    },
    {
      "index": 56,
      "text": "擺動手指和腳趾。",
      "file": "c056.ogg",
      "durationSec": 4.44
    },
    {
      "index": 57,
      "text": "輕輕地睜開眼睛。",
      "file": "c057.ogg",
      "durationSec": 4.368
    },
    {
      "index": 58,
      "text": "隨身攜帶一點這種平靜。",
      "file": "c058.ogg",
      "durationSec": 5.424
    }
  ]
}
