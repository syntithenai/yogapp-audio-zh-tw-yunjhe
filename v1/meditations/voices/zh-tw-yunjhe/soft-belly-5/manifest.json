{
  "id": "soft-belly-5",
  "voiceId": "zh-tw-yunjhe",
  "edgeVoice": "zh-TW-YunJheNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 153,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "找一個舒適的座位，或者如果感覺好一點的話就躺下來。",
      "file": "c001.ogg",
      "durationSec": 8.856
    },
    {
      "index": 2,
      "text": "讓雙手休息一下。",
      "file": "c002.ogg",
      "durationSec": 4.32
    },
    {
      "index": 3,
      "text": "軟化眼睛，或閉上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.448
    },
    {
      "index": 4,
      "text": "緩慢吸氣。",
      "file": "c004.ogg",
      "durationSec": 3.528
    },
    {
      "index": 5,
      "text": "並且呼氣時間更長。",
      "file": "c005.ogg",
      "durationSec": 4.656
    },
    {
      "index": 6,
      "text": "如果願意，可以將手放在下腹部。",
      "file": "c006.ogg",
      "durationSec": 6.384
    },
    {
      "index": 7,
      "text": "注意腹部是否受力。",
      "file": "c007.ogg",
      "durationSec": 4.416
    },
    {
      "index": 8,
      "text": "[暫停：20]",
      "file": "c008.ogg",
      "durationSec": 4.44
    },
    {
      "index": 9,
      "text": "下一次吸氣時，讓腹部擴張。",
      "file": "c009.ogg",
      "durationSec": 5.808
    },
    {
      "index": 10,
      "text": "呼氣時，讓它落下，不要擠壓。",
      "file": "c010.ogg",
      "durationSec": 6.672
    },
    {
      "index": 11,
      "text": "[暫停：20]",
      "file": "c011.ogg",
      "durationSec": 4.44
    },
    {
      "index": 12,
      "text": "再次。肚子軟軟的進去了",
      "file": "c012.ogg",
      "durationSec": 7.2
    },
    {
      "index": 13,
      "text": "肚子軟了。",
      "file": "c013.ogg",
      "durationSec": 3.048
    },
    {
      "index": 14,
      "text": "[暫停：25]",
      "file": "c014.ogg",
      "durationSec": 4.488
    },
    {
      "index": 15,
      "text": "如果頭腦爭論，就讓身體來引導。",
      "file": "c015.ogg",
      "durationSec": 6.408
    },
    {
      "index": 16,
      "text": "擴張。釋出。",
      "file": "c016.ogg",
      "durationSec": 5.736
    },
    {
      "index": 17,
      "text": "[暫停：29]",
      "file": "c017.ogg",
      "durationSec": 4.632
    },
    {
      "index": 18,
      "text": "肩膀下垂。",
      "file": "c018.ogg",
      "durationSec": 3.648
    },
    {
      "index": 19,
      "text": "下巴軟了",
      "file": "c019.ogg",
      "durationSec": 3.264
    },
    {
      "index": 20,
      "text": "腹部自由。",
      "file": "c020.ogg",
      "durationSec": 3.528
    },
    {
      "index": 21,
      "text": "[暫停：25]",
      "file": "c021.ogg",
      "durationSec": 4.488
    },
    {
      "index": 22,
      "text": "保持十次輕柔的腹部呼吸。",
      "file": "c022.ogg",
      "durationSec": 5.136
    },
    {
      "index": 23,
      "text": "[暫停：45]",
      "file": "c023.ogg",
      "durationSec": 4.632
    },
    {
      "index": 24,
      "text": "注意任何到來的輕鬆。",
      "file": "c024.ogg",
      "durationSec": 4.416
    },
    {
      "index": 25,
      "text": "[暫停：20]",
      "file": "c025.ogg",
      "durationSec": 4.44
    },
    {
      "index": 26,
      "text": "在這裡休息。",
      "file": "c026.ogg",
      "durationSec": 3.768
    },
    {
      "index": 27,
      "text": "[暫停：27]",
      "file": "c027.ogg",
      "durationSec": 4.392
    },
    {
      "index": 28,
      "text": "再輕鬆地吸一口氣。",
      "file": "c028.ogg",
      "durationSec": 4.44
    },
    {
      "index": 29,
      "text": "動動手指。",
      "file": "c029.ogg",
      "durationSec": 3.432
    },
    {
      "index": 30,
      "text": "準備好後，睜開眼睛。",
      "file": "c030.ogg",
      "durationSec": 5.304
    },
    {
      "index": 31,
      "text": "隨身攜帶一點這個。",
      "file": "c031.ogg",
      "durationSec": 4.56
    }
  ]
}
