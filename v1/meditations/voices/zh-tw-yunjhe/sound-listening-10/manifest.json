  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "需要時間到達。",
      "file": "c001.ogg",
      "durationSec": 4.104
    },
    {
      "index": 2,
      "text": "在支撐下坐下或躺下。",
      "file": "c002.ogg",
      "durationSec": 4.992
    },
    {
      "index": 3,
      "text": "如果感覺安全，請閉上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.976
    },
    {
      "index": 4,
      "text": "感受與地面的接觸。",
      "file": "c004.ogg",
      "durationSec": 4.632
    },
    {
      "index": 5,
      "text": "緩慢吸氣。",
      "file": "c005.ogg",
      "durationSec": 3.528
    },
    {
      "index": 6,
      "text": "呼氣時間更長。",
      "file": "c006.ogg",
      "durationSec": 4.128
    },
    {
      "index": 7,
      "text": "[暫停：23]",
      "file": "c007.ogg",
      "durationSec": 4.416
    },
    {
      "index": 8,
      "text": "再次。",
      "file": "c008.ogg",
      "durationSec": 3.096
    },
    {
      "index": 9,
      "text": "[暫停：23]",
      "file": "c009.ogg",
      "durationSec": 4.416
    },
    {
      "index": 10,
      "text": "讓肩膀下垂。",
      "file": "c010.ogg",
      "durationSec": 3.936
    },
    {
      "index": 11,
      "text": "讓腹部變軟。",
      "file": "c011.ogg",
      "durationSec": 3.6
    },
    {
      "index": 12,
      "text": "[暫停：29]",
      "file": "c012.ogg",
      "durationSec": 4.632
    },
    {
      "index": 13,
      "text": "開啟耳朵。",
      "file": "c013.ogg",
      "durationSec": 3.432
    },
    {
      "index": 14,
      "text": "注意最近的聲音。",
      "file": "c014.ogg",
      "durationSec": 3.936
    },
    {
      "index": 15,
      "text": "[暫停：29]",
      "file": "c015.ogg",
      "durationSec": 4.632
    },
    {
      "index": 16,
      "text": "注意您能聽到的最遠的聲音。",
      "file": "c016.ogg",
      "durationSec": 5.064
    },
    {
      "index": 17,
      "text": "[暫停：29]",
      "file": "c017.ogg",
      "durationSec": 4.632
    },
    {
      "index": 18,
      "text": "注意聲音之間的安靜。",
      "file": "c018.ogg",
      "durationSec": 4.68
    },
    {
      "index": 19,
      "text": "[暫停：35]",
      "file": "c019.ogg",
      "durationSec": 4.632
    },
    {
      "index": 20,
      "text": "聲音出現並消失。您不需要說出它們的名稱。",
      "file": "c020.ogg",
      "durationSec": 9.696
    },
    {
      "index": 21,
      "text": "聞則聞之。",
      "file": "c021.ogg",
      "durationSec": 3.288
    },
    {
      "index": 22,
      "text": "[暫停：47]",
      "file": "c022.ogg",
      "durationSec": 4.44
    },
    {
      "index": 23,
      "text": "當思緒走神時，回到聆聽。",
      "file": "c023.ogg",
      "durationSec": 5.568
    },
    {
      "index": 24,
      "text": "[暫停：35]",
      "file": "c024.ogg",
      "durationSec": 4.632
    },
    {
      "index": 25,
      "text": "包括你自己的呼吸聲。",
      "file": "c025.ogg",
      "durationSec": 4.608
    },
    {
      "index": 26,
      "text": "[暫停：35]",
      "file": "c026.ogg",
      "durationSec": 4.632
    },
    {
      "index": 27,
      "text": "在整個音景中休息。",
      "file": "c027.ogg",
      "durationSec": 4.536
