      "text": "開始加深呼吸。",
      "file": "c033.ogg",
      "durationSec": 4.056
    },
    {
      "index": 34,
      "text": "在這裡休息。",
      "file": "c034.ogg",
      "durationSec": 3.768
    },
    {
      "index": 35,
      "text": "[暫停：27]",
      "file": "c035.ogg",
      "durationSec": 4.392
    },
    {
      "index": 36,
      "text": "再次感受一下房間。",
      "file": "c036.ogg",
      "durationSec": 4.296
