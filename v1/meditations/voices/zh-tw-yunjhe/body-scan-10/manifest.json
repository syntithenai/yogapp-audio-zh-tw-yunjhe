  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "需要時間到達。",
      "file": "c001.ogg",
      "durationSec": 4.104
    },
    {
      "index": 2,
      "text": "在支撐下坐下或躺下。",
      "file": "c002.ogg",
      "durationSec": 4.992
    },
    {
      "index": 3,
      "text": "如果感覺安全，請閉上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.976
    },
    {
      "index": 4,
      "text": "感受與地面的接觸。",
      "file": "c004.ogg",
      "durationSec": 4.632
    },
    {
      "index": 5,
      "text": "緩慢吸氣。",
      "file": "c005.ogg",
      "durationSec": 3.528
    },
    {
      "index": 6,
      "text": "呼氣時間更長。",
      "file": "c006.ogg",
      "durationSec": 4.128
    },
    {
      "index": 7,
      "text": "[暫停：21]",
      "file": "c007.ogg",
      "durationSec": 4.464
    },
    {
      "index": 8,
      "text": "再次。",
      "file": "c008.ogg",
      "durationSec": 3.096
    },
    {
      "index": 9,
      "text": "[暫停：21]",
      "file": "c009.ogg",
      "durationSec": 4.464
    },
    {
      "index": 10,
      "text": "讓肩膀下垂。",
      "file": "c010.ogg",
      "durationSec": 3.936
    },
    {
      "index": 11,
      "text": "讓腹部變軟。",
      "file": "c011.ogg",
      "durationSec": 3.6
    },
    {
      "index": 12,
      "text": "[暫停：27]",
      "file": "c012.ogg",
      "durationSec": 4.392
    },
    {
      "index": 13,
      "text": "從頭頂開始。",
      "file": "c013.ogg",
      "durationSec": 3.864
    },
    {
      "index": 14,
      "text": "注意感覺或缺乏感覺。",
      "file": "c014.ogg",
      "durationSec": 5.064
    },
    {
      "index": 15,
      "text": "[暫停：27]",
      "file": "c015.ogg",
      "durationSec": 4.392
    },
    {
      "index": 16,
      "text": "前額。眼睛。臉頰。顎。",
      "file": "c016.ogg",
      "durationSec": 11.424
    },
    {
      "index": 17,
      "text": "讓臉稍微融化一點。",
      "file": "c017.ogg",
      "durationSec": 4.56
    },
    {
      "index": 18,
      "text": "[暫停：27]",
      "file": "c018.ogg",
      "durationSec": 4.392
    },
    {
      "index": 19,
      "text": "喉。脖子。肩膀。",
      "file": "c019.ogg",
      "durationSec": 8.496
    },
    {
      "index": 20,
      "text": "讓肩膀垂下。",
      "file": "c020.ogg",
      "durationSec": 3.888
    },
    {
      "index": 21,
      "text": "[暫停：32]",
      "file": "c021.ogg",
      "durationSec": 4.632
    },
    {
      "index": 22,
      "text": "武器。肘部。手腕。手。手指。",
      "file": "c022.ogg",
      "durationSec": 14.64
    },
    {
      "index": 23,
      "text": "[暫停：32]",
      "file": "c023.ogg",
      "durationSec": 4.632
    },
    {
      "index": 24,
      "text": "胸部起伏。",
      "file": "c024.ogg",
      "durationSec": 3.648
    },
    {
      "index": 25,
      "text": "心空間柔軟。",
      "file": "c025.ogg",
      "durationSec": 3.936
    },
    {
      "index": 26,
      "text": "[暫停：27]",
      "file": "c026.ogg",
      "durationSec": 4.392
    },
    {
      "index": 27,
      "text": "腹部。低背。臀部。",
      "file": "c027.ogg",
      "durationSec": 8.784
    },
    {
      "index": 28,
      "text": "[暫停：32]",
      "file": "c028.ogg",
      "durationSec": 4.632
    },
    {
      "index": 29,
      "text": "大腿。膝蓋。小牛。腳踝。腳。腳趾。",
      "file": "c029.ogg",
      "durationSec": 17.376
    },
    {
      "index": 30,
      "text": "[暫停：38]",
      "file": "c030.ogg",
      "durationSec": 4.488
    },
    {
      "index": 31,
      "text": "感覺整個身體就像一個場。",
      "file": "c031.ogg",
      "durationSec": 5.16
    },
    {
      "index": 32,
      "text": "呼吸在其中流動。",
      "file": "c032.ogg",
      "durationSec": 4.464
    },
    {
      "index": 33,
      "text": "[暫停：54]",
      "file": "c033.ogg",
      "durationSec": 4.704
    },
    {
      "index": 34,
      "text": "如果某個地方仍然緊張，就在那裡呼氣。",
      "file": "c034.ogg",
      "durationSec": 7.224
    },
    {
      "index": 35,
      "text": "[暫停：43]",
      "file": "c035.ogg",
      "durationSec": 4.464
    },
    {
      "index": 36,
      "text": "在全身意識中休息。",
      "file": "c036.ogg",
      "durationSec": 4.872
    },
    {
      "index": 37,
      "text": "[暫停：81]",
      "file": "c037.ogg",
      "durationSec": 4.392
    },
    {
      "index": 38,
      "text": "[暫停：32]",
      "file": "c038.ogg",
      "durationSec": 4.632
    },
    {
      "index": 39,
      "text": "開始加深呼吸。",
      "file": "c039.ogg",
      "durationSec": 4.056
    },
    {
      "index": 40,
      "text": "再次感受一下房間。",
      "file": "c040.ogg",
      "durationSec": 4.296
    },
    {
      "index": 41,
      "text": "擺動手指和腳趾。",
      "file": "c041.ogg",
      "durationSec": 4.44
    },
    {
