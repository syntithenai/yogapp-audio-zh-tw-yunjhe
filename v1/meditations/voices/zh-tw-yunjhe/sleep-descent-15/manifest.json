  "totalSec": 201,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎來到睡眠練習。",
      "file": "c000.ogg",
      "durationSec": 4.944
    },
    {
      "index": 1,
      "text": "躺。讓黑暗成為你的朋友。",
      "file": "c001.ogg",
      "durationSec": 7.368
    },
    {
      "index": 2,
      "text": "你可能會在結束前睡著。這就是成功。",
      "file": "c002.ogg",
      "durationSec": 8.928
    },
    {
      "index": 3,
      "text": "[暫停：22]",
      "file": "c003.ogg",
      "durationSec": 4.536
    },
    {
      "index": 4,
      "text": "緩慢吸氣。",
      "file": "c004.ogg",
      "durationSec": 3.528
    },
    {
      "index": 5,
      "text": "呼氣時間更長。",
      "file": "c005.ogg",
      "durationSec": 4.128
    },
    {
      "index": 6,
      "text": "[暫停：22]",
      "file": "c006.ogg",
      "durationSec": 4.536
    },
    {
      "index": 7,
      "text": "鬆開額頭。",
      "file": "c007.ogg",
      "durationSec": 3.552
    },
    {
      "index": 8,
      "text": "[暫停：18]",
      "file": "c008.ogg",
      "durationSec": 4.176
    },
    {
      "index": 9,
      "text": "鬆開眼睛。",
      "file": "c009.ogg",
      "durationSec": 3.528
    },
    {
      "index": 10,
      "text": "[暫停：18]",
      "file": "c010.ogg",
      "durationSec": 4.176
    },
    {
      "index": 11,
      "text": "鬆開下巴和舌頭。",
      "file": "c011.ogg",
      "durationSec": 4.68
    },
    {
      "index": 12,
      "text": "[暫停：22]",
      "file": "c012.ogg",
      "durationSec": 4.536
    },
    {
      "index": 13,
      "text": "肩膀融化了。",
      "file": "c013.ogg",
      "durationSec": 3.6
    },
    {
      "index": 14,
      "text": "[暫停：22]",
      "file": "c014.ogg",
      "durationSec": 4.536
    },
    {
      "index": 15,
      "text": "手臂沉重。雙手張開。",
      "file": "c015.ogg",
      "durationSec": 6.936
    },
    {
      "index": 16,
      "text": "[暫停：22]",
      "file": "c016.ogg",
      "durationSec": 4.536
    },
    {
      "index": 17,
      "text": "胸口軟軟的。肚子軟了。",
      "file": "c017.ogg",
      "durationSec": 6.696
    },
    {
      "index": 18,
      "text": "[暫停：22]",
      "file": "c018.ogg",
      "durationSec": 4.536
    },
    {
      "index": 19,
      "text": "臀部沉重。",
      "file": "c019.ogg",
      "durationSec": 3.6
    },
    {
      "index": 20,
      "text": "[暫停：22]",
      "file": "c020.ogg",
      "durationSec": 4.536
    },
    {
      "index": 21,
      "text": "腿很重。腳很重。",
      "file": "c021.ogg",
      "durationSec": 6.384
    },
    {
      "index": 22,
      "text": "[暫停：27]",
      "file": "c022.ogg",
      "durationSec": 4.392
    },
    {
      "index": 23,
      "text": "整個人都陷進了床上。",
      "file": "c023.ogg",
      "durationSec": 4.776
    },
    {
      "index": 24,
      "text": "[暫停：36]",
      "file": "c024.ogg",
      "durationSec": 4.704
    },
    {
      "index": 25,
      "text": "思想就像遙遠的交通。",
      "file": "c025.ogg",
      "durationSec": 4.8
    },
    {
      "index": 26,
      "text": "你不跟隨他們。",
      "file": "c026.ogg",
      "durationSec": 4.032
    },
    {
      "index": 27,
      "text": "[暫停：45]",
      "file": "c027.ogg",
      "durationSec": 4.632
    },
    {
      "index": 28,
      "text": "呼吸更平靜。",
      "file": "c028.ogg",
      "durationSec": 3.936
    },
    {
      "index": 29,
      "text": "[暫停：45]",
      "file": "c029.ogg",
      "durationSec": 4.632
    },
    {
      "index": 30,
      "text": "更暗。更柔軟。慢點。",
      "file": "c030.ogg",
      "durationSec": 8.856
    },
    {
      "index": 31,
      "text": "[暫停：67]",
      "file": "c031.ogg",
      "durationSec": 4.344
    },
    {
      "index": 32,
      "text": "沒什麼要完成的。",
      "file": "c032.ogg",
      "durationSec": 4.248
    },
    {
      "index": 33,
      "text": "[暫停：54]",
      "file": "c033.ogg",
      "durationSec": 4.704
    },
    {
      "index": 34,
      "text": "可以安全休息了。",
      "file": "c034.ogg",
      "durationSec": 4.008
    },
    {
      "index": 35,
      "text": "[暫停：89]",
      "file": "c035.ogg",
      "durationSec": 4.632
    },
    {
      "index": 36,
      "text": "安全睡覺。",
      "file": "c036.ogg",
      "durationSec": 3.528
    },
    {
      "index": 37,
      "text": "[暫停：112]",
      "file": "c037.ogg",
      "durationSec": 4.944
    },
    {
      "index": 38,
      "text": "如果你還醒著，繼續呼氣休息。",
