{
  "id": "self-compassion-5",
  "voiceId": "zh-tw-yunjhe",
  "edgeVoice": "zh-TW-YunJheNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 141,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "找一個舒適的座位，或者如果感覺好一點的話就躺下來。",
      "file": "c001.ogg",
      "durationSec": 8.856
    },
    {
      "index": 2,
      "text": "讓雙手休息一下。",
      "file": "c002.ogg",
      "durationSec": 4.32
    },
    {
      "index": 3,
      "text": "軟化眼睛，或閉上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.448
    },
    {
      "index": 4,
      "text": "緩慢吸氣。",
      "file": "c004.ogg",
      "durationSec": 3.528
    },
    {
      "index": 5,
      "text": "並且呼氣時間更長。",
      "file": "c005.ogg",
      "durationSec": 4.656
    },
    {
      "index": 6,
      "text": "將手放在心臟上，或將雙手放在膝蓋上。",
      "file": "c006.ogg",
      "durationSec": 7.536
    },
    {
      "index": 7,
      "text": "注意你現在的樣子，但不要去修正它。",
      "file": "c007.ogg",
      "durationSec": 6.408
    },
    {
      "index": 8,
      "text": "[暫停：31]",
      "file": "c008.ogg",
      "durationSec": 4.584
    },
    {
      "index": 9,
      "text": "如果有掙扎，承認它。",
      "file": "c009.ogg",
      "durationSec": 5.184
    },
    {
      "index": 10,
      "text": "這是一個困難的時刻。",
      "file": "c010.ogg",
      "durationSec": 4.488
    },
    {
      "index": 11,
      "text": "困難是人類的一部分。",
      "file": "c011.ogg",
      "durationSec": 4.752
    },
    {
      "index": 12,
      "text": "[暫停：39]",
      "file": "c012.ogg",
      "durationSec": 4.752
    },
    {
      "index": 13,
      "text": "像對待朋友一樣善待自己。",
      "file": "c013.ogg",
      "durationSec": 5.328
    },
    {
      "index": 14,
      "text": "願我善待自己。",
      "file": "c014.ogg",
      "durationSec": 3.912
    },
    {
      "index": 15,
      "text": "願我給予自己我所需要的同情心。",
      "file": "c015.ogg",
      "durationSec": 5.76
    },
    {
      "index": 16,
      "text": "[暫停：39]",
      "file": "c016.ogg",
      "durationSec": 4.752
    },
    {
      "index": 17,
      "text": "再次，慢慢地。",
      "file": "c017.ogg",
      "durationSec": 4.536
    },
    {
      "index": 18,
      "text": "願我善待自己。",
      "file": "c018.ogg",
      "durationSec": 3.912
    },
    {
      "index": 19,
      "text": "願我給予自己我所需要的同情心。",
      "file": "c019.ogg",
      "durationSec": 5.76
    },
    {
      "index": 20,
      "text": "[暫停：45]",
      "file": "c020.ogg",
      "durationSec": 4.632
    },
    {
      "index": 21,
      "text": "呼吸到放在心臟上的手（如果有的話）。",
      "file": "c021.ogg",
      "durationSec": 7.176
    },
    {
      "index": 22,
      "text": "[暫停：39]",
      "file": "c022.ogg",
      "durationSec": 4.752
    },
    {
      "index": 23,
      "text": "你不必贏得這種柔軟。",
      "file": "c023.ogg",
      "durationSec": 4.872
    },
    {
      "index": 24,
      "text": "再輕鬆地吸一口氣。",
      "file": "c024.ogg",
      "durationSec": 4.44
    },
    {
      "index": 25,
      "text": "動動手指。",
      "file": "c025.ogg",
      "durationSec": 3.432
    },
    {
      "index": 26,
      "text": "準備好後，睜開眼睛。",
      "file": "c026.ogg",
      "durationSec": 5.304
    },
    {
      "index": 27,
      "text": "隨身攜帶一點這個。",
      "file": "c027.ogg",
      "durationSec": 4.56
    }
  ]
}
