{
  "id": "cove-shore-5",
  "voiceId": "zh-tw-yunjhe",
  "edgeVoice": "zh-TW-YunJheNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 351,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "找一個舒適的座位，或者如果感覺好一點的話就躺下來。",
      "file": "c001.ogg",
      "durationSec": 8.856
    },
    {
      "index": 2,
      "text": "讓你的雙手休息一下。",
      "file": "c002.ogg",
      "durationSec": 4.56
    },
    {
      "index": 3,
      "text": "讓你的眼睛閉上，或者軟化你的目光。",
      "file": "c003.ogg",
      "durationSec": 6.552
    },
    {
      "index": 4,
      "text": "注意你所承受的身體重量。",
      "file": "c004.ogg",
      "durationSec": 5.376
    },
    {
      "index": 5,
      "text": "透過鼻子緩慢吸氣。",
      "file": "c005.ogg",
      "durationSec": 4.56
    },
    {
      "index": 6,
      "text": "並且呼氣時間更長、更輕鬆。",
      "file": "c006.ogg",
      "durationSec": 5.928
    },
    {
      "index": 7,
      "text": "再次。輕輕吸氣。",
      "file": "c007.ogg",
      "durationSec": 6.6
    },
    {
      "index": 8,
      "text": "輕輕呼氣。",
      "file": "c008.ogg",
      "durationSec": 3.672
    },
    {
      "index": 9,
      "text": "如果思緒遊離，那也沒關係。回到呼吸。",
      "file": "c009.ogg",
      "durationSec": 9.024
    },
    {
      "index": 10,
      "text": "想象自己到達了一個受庇護的海灣。",
      "file": "c010.ogg",
      "durationSec": 5.976
    },
    {
      "index": 11,
      "text": "懸崖環繞著柔軟的淺色沙灘。",
      "file": "c011.ogg",
      "durationSec": 5.328
    },
    {
      "index": 12,
      "text": "大海在低沉而耐心的波浪中移動。",
      "file": "c012.ogg",
      "durationSec": 6.288
    },
    {
      "index": 13,
      "text": "溫和的陽光溫暖著你的肩膀。",
      "file": "c013.ogg",
      "durationSec": 5.52
    },
    {
      "index": 14,
      "text": "鹹鹹的微風吹過你的嘴唇和眼瞼。",
      "file": "c014.ogg",
      "durationSec": 6.36
    },
    {
      "index": 15,
      "text": "感受充滿你胸腔的新鮮空氣。",
      "file": "c015.ogg",
      "durationSec": 5.736
    },
    {
      "index": 16,
      "text": "步行至水線。溼沙擁抱你的腳。",
      "file": "c016.ogg",
      "durationSec": 8.16
    },
    {
      "index": 17,
      "text": "涼爽的泡沫接觸到您的腳踝並滑落。",
      "file": "c017.ogg",
      "durationSec": 6.408
    },
    {
      "index": 18,
      "text": "節奏很簡單。到達。軟化。離開。",
      "file": "c018.ogg",
      "durationSec": 12.36
    },
    {
      "index": 19,
      "text": "坐在腳下溫暖的幹沙處。",
      "file": "c019.ogg",
      "durationSec": 4.8
    },
    {
      "index": 20,
      "text": "向後靠在你的手上。感受顆粒狀的熱量。",
      "file": "c020.ogg",
      "durationSec": 9.048
    },
    {
      "index": 21,
      "text": "聆聽海灣的喧囂和喧囂。",
      "file": "c021.ogg",
      "durationSec": 5.088
    },
    {
      "index": 22,
      "text": "聞鹽、陽光和乾淨石頭的味道。",
      "file": "c022.ogg",
      "durationSec": 6.264
    },
    {
      "index": 23,
      "text": "皮膚上充滿溫暖。每次吸氣都是清涼的。",
      "file": "c023.ogg",
      "durationSec": 9.264
    },
    {
      "index": 24,
      "text": "遠處，燈光閃爍，就像安靜的笑聲。",
      "file": "c024.ogg",
      "durationSec": 7.224
    },
    {
      "index": 25,
      "text": "你不需要追逐它。它已經在這裡了。",
      "file": "c025.ogg",
      "durationSec": 7.968
    },
    {
      "index": 26,
      "text": "波浪到達更遠的地方，冷卻你的腳趾，然後撤退。",
      "file": "c026.ogg",
      "durationSec": 8.304
    },
    {
      "index": 27,
      "text": "溫暖的沙子讓你的雙腳恢復活力。",
      "file": "c027.ogg",
      "durationSec": 6.0
    },
    {
      "index": 28,
      "text": "讓你的呼吸隨著波浪移動——緩慢地進入，更長的時間。",
      "file": "c028.ogg",
      "durationSec": 8.808
    },
    {
      "index": 29,
      "text": "和平就是海灣本身。你在裡面。",
      "file": "c029.ogg",
      "durationSec": 8.16
    },
    {
      "index": 30,
      "text": "將注意力集中在肩胛骨之間的溫暖處。",
      "file": "c030.ogg",
      "durationSec": 6.624
    },
    {
      "index": 31,
      "text": "還有鼻尖新鮮的鹹味空氣。",
      "file": "c031.ogg",
      "durationSec": 5.496
    },
    {
      "index": 32,
      "text": "用柔軟的想象力描繪懸崖線。",
      "file": "c032.ogg",
      "durationSec": 5.568
    },
    {
      "index": 33,
      "text": "石頭白天變暖。褶皺中的陰影很酷。",
      "file": "c033.ogg",
      "durationSec": 8.592
    },
    {
      "index": 34,
      "text": "附近的潮汐池裡有一個清澈的小世界。",
      "file": "c034.ogg",
      "durationSec": 6.336
    },
    {
      "index": 35,
      "text": "你不需要靠進去。知道它就在那裡就足夠了。",
      "file": "c035.ogg",
      "durationSec": 9.264
    },
    {
      "index": 36,
      "text": "又一波。涼爽的腳踝。溫暖的沙子。輕柔的呼吸。",
      "file": "c036.ogg",
      "durationSec": 13.584
    },
    {
      "index": 37,
      "text": "海灣繼續提供同樣簡單的善意。",
      "file": "c037.ogg",
      "durationSec": 6.024
    },
    {
      "index": 38,
      "text": "在您離開之前再次收到它。",
      "file": "c038.ogg",
      "durationSec": 5.184
    },
    {
      "index": 39,
      "text": "現在獨自在呼吸中休息一會兒。",
      "file": "c039.ogg",
      "durationSec": 5.856
    },
    {
      "index": 40,
      "text": "慢慢吸氣。",
      "file": "c040.ogg",
      "durationSec": 3.432
    },
    {
      "index": 41,
      "text": "慢慢呼氣。",
      "file": "c041.ogg",
      "durationSec": 3.456
    },
    {
      "index": 42,
      "text": "吸氣。",
      "file": "c042.ogg",
      "durationSec": 3.12
    },
    {
      "index": 43,
      "text": "呼氣。",
      "file": "c043.ogg",
      "durationSec": 3.072
    },
    {
      "index": 44,
      "text": "身體哪裡溫暖，哪裡就感覺溫暖。",
      "file": "c044.ogg",
      "durationSec": 6.408
    },
    {
      "index": 45,
      "text": "空氣涼爽的地方都會感到涼爽。",
      "file": "c045.ogg",
      "durationSec": 5.808
    },
    {
      "index": 46,
      "text": "吸氣。",
      "file": "c046.ogg",
      "durationSec": 3.12
    },
    {
      "index": 47,
      "text": "呼氣。",
      "file": "c047.ogg",
      "durationSec": 3.072
    },
    {
      "index": 48,
      "text": "無處可去。沒什麼可修復的。",
      "file": "c048.ogg",
      "durationSec": 7.608
    },
    {
      "index": 49,
      "text": "吸氣。",
      "file": "c049.ogg",
      "durationSec": 3.12
    },
    {
      "index": 50,
      "text": "呼氣。",
      "file": "c050.ogg",
      "durationSec": 3.072
    },
    {
      "index": 51,
      "text": "在這裡休息一下，安靜地呼吸幾口氣。",
      "file": "c051.ogg",
      "durationSec": 6.84
    },
    {
      "index": 52,
      "text": "要知道你可以隨時回到這個地方。",
      "file": "c052.ogg",
      "durationSec": 5.616
    },
    {
      "index": 53,
      "text": "當你準備好後，加深呼吸。",
      "file": "c053.ogg",
      "durationSec": 5.544
    },
    {
      "index": 54,
      "text": "擺動手指和腳趾。",
      "file": "c054.ogg",
      "durationSec": 4.44
    },
    {
      "index": 55,
      "text": "輕輕地睜開眼睛。",
      "file": "c055.ogg",
      "durationSec": 4.368
    },
    {
      "index": 56,
      "text": "隨身攜帶一點這種平靜。",
      "file": "c056.ogg",
      "durationSec": 5.424
    }
  ]
}
