{
  "id": "forgiveness-soft-10",
  "voiceId": "zh-tw-yunjhe",
  "edgeVoice": "zh-TW-YunJheNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 189,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "需要時間到達。",
      "file": "c001.ogg",
      "durationSec": 4.104
    },
    {
      "index": 2,
      "text": "在支撐下坐下或躺下。",
      "file": "c002.ogg",
      "durationSec": 4.992
    },
    {
      "index": 3,
      "text": "如果感覺安全，請閉上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.976
    },
    {
      "index": 4,
      "text": "感受與地面的接觸。",
      "file": "c004.ogg",
      "durationSec": 4.632
    },
    {
      "index": 5,
      "text": "緩慢吸氣。",
      "file": "c005.ogg",
      "durationSec": 3.528
    },
    {
      "index": 6,
      "text": "呼氣時間更長。",
      "file": "c006.ogg",
      "durationSec": 4.128
    },
    {
      "index": 7,
      "text": "[暫停：27]",
      "file": "c007.ogg",
      "durationSec": 4.392
    },
    {
      "index": 8,
      "text": "再次。",
      "file": "c008.ogg",
      "durationSec": 3.096
    },
    {
      "index": 9,
      "text": "[暫停：27]",
      "file": "c009.ogg",
      "durationSec": 4.392
    },
    {
      "index": 10,
      "text": "讓肩膀下垂。",
      "file": "c010.ogg",
      "durationSec": 3.936
    },
    {
      "index": 11,
      "text": "讓腹部變軟。",
      "file": "c011.ogg",
      "durationSec": 3.6
    },
    {
      "index": 12,
      "text": "[暫停：34]",
      "file": "c012.ogg",
      "durationSec": 4.728
    },
    {
      "index": 13,
      "text": "這裡的寬恕意味著鬆開自己緊握的拳頭。",
      "file": "c013.ogg",
      "durationSec": 6.936
    },
    {
      "index": 14,
      "text": "不假裝傷害並不重要。",
      "file": "c014.ogg",
      "durationSec": 5.016
    },
    {
      "index": 15,
      "text": "[暫停：34]",
      "file": "c015.ogg",
      "durationSec": 4.728
    },
    {
      "index": 16,
      "text": "從一些你反對自己的小事開始。",
      "file": "c016.ogg",
      "durationSec": 5.736
    },
    {
      "index": 17,
      "text": "一個錯誤。一個缺點。",
      "file": "c017.ogg",
      "durationSec": 6.552
    },
    {
      "index": 18,
      "text": "[暫停：34]",
      "file": "c018.ogg",
      "durationSec": 4.728
    },
    {
      "index": 19,
      "text": "默默地：我原諒自己是個人類。",
      "file": "c019.ogg",
      "durationSec": 5.76
    },
    {
      "index": 20,
      "text": "我釋放我不再需要攜帶的東西。",
      "file": "c020.ogg",
      "durationSec": 5.448
    },
    {
      "index": 21,
      "text": "[暫停：54]",
      "file": "c021.ogg",
      "durationSec": 4.704
    },
    {
      "index": 22,
      "text": "如果感覺不錯，請想象另一個人遇到的輕微困難。",
      "file": "c022.ogg",
      "durationSec": 7.992
    },
    {
      "index": 23,
      "text": "這不是最難的故事。更輕的。",
      "file": "c023.ogg",
      "durationSec": 7.344
    },
    {
      "index": 24,
      "text": "[暫停：34]",
      "file": "c024.ogg",
      "durationSec": 4.728
    },
    {
      "index": 25,
      "text": "我釋放我能釋放的。",
      "file": "c025.ogg",
      "durationSec": 4.464
    },
    {
      "index": 26,
      "text": "我保留我的界限。我放下了額外的重量。",
      "file": "c026.ogg",
      "durationSec": 8.592
    },
    {
      "index": 27,
      "text": "[暫停：54]",
      "file": "c027.ogg",
      "durationSec": 4.704
    },
    {
      "index": 28,
      "text": "呼吸到緊繃的地方。",
      "file": "c028.ogg",
      "durationSec": 4.272
    },
    {
      "index": 29,
      "text": "[暫停：68]",
      "file": "c029.ogg",
      "durationSec": 4.32
    },
    {
      "index": 30,
      "text": "在拳頭軟化時開啟的空間中休息。",
      "file": "c030.ogg",
      "durationSec": 6.24
    },
    {
      "index": 31,
      "text": "[暫停：81]",
      "file": "c031.ogg",
      "durationSec": 4.392
    },
    {
      "index": 32,
      "text": "[暫停：41]",
      "file": "c032.ogg",
      "durationSec": 4.536
    },
    {
      "index": 33,
      "text": "開始加深呼吸。",
      "file": "c033.ogg",
      "durationSec": 4.056
    },
    {
      "index": 34,
      "text": "再次感受一下房間。",
      "file": "c034.ogg",
      "durationSec": 4.296
    },
    {
      "index": 35,
      "text": "擺動手指和腳趾。",
      "file": "c035.ogg",
      "durationSec": 4.44
    },
    {
      "index": 36,
      "text": "準備好後，睜開眼睛。",
      "file": "c036.ogg",
      "durationSec": 5.304
    },
    {
      "index": 37,
      "text": "慢慢地進入接下來的事情。",
      "file": "c037.ogg",
      "durationSec": 5.04
    }
  ]
}
