      "durationSec": 3.12
    },
    {
      "index": 35,
      "text": "[暫停：19]",
      "file": "c035.ogg",
      "durationSec": 4.488
    },
    {
      "index": 36,
      "text": "釋出。",
      "file": "c036.ogg",
      "durationSec": 2.952
    },
    {
      "index": 37,
      "text": "手指張開。手臂沉重。",
      "file": "c037.ogg",
      "durationSec": 6.936
    },
    {
      "index": 38,
      "text": "[暫停：21]",
      "file": "c038.ogg",
