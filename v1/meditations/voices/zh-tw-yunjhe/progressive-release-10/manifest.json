  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "這種練習使用溫和的緊張和放鬆。",
      "file": "c001.ogg",
      "durationSec": 6.024
    },
    {
      "index": 2,
      "text": "如果可以的話請躺下，或者在有支撐的情況下坐下。",
      "file": "c002.ogg",
      "durationSec": 8.232
    },
    {
      "index": 3,
      "text": "如果感覺安全，請閉上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.976
    },
    {
      "index": 4,
      "text": "沒什麼好強求的。保持在舒適的範圍內。",
      "file": "c004.ogg",
      "durationSec": 8.808
    },
    {
      "index": 5,
      "text": "緩慢吸氣。",
      "file": "c005.ogg",
      "durationSec": 3.528
    },
    {
      "index": 6,
      "text": "並且呼氣時間更長。",
      "file": "c006.ogg",
      "durationSec": 4.656
    },
    {
      "index": 7,
      "text": "[暫停：19]",
      "file": "c007.ogg",
      "durationSec": 4.488
    },
    {
      "index": 8,
      "text": "將注意力集中在雙腳上。",
      "file": "c008.ogg",
      "durationSec": 5.16
    },
    {
      "index": 9,
      "text": "捲曲腳趾並收緊腳部。",
      "file": "c009.ogg",
      "durationSec": 5.088
    },
    {
      "index": 10,
      "text": "抓住。",
      "file": "c010.ogg",
      "durationSec": 3.12
    },
    {
      "index": 11,
      "text": "[暫停：19]",
      "file": "c011.ogg",
      "durationSec": 4.488
    },
    {
      "index": 12,
      "text": "釋出。",
      "file": "c012.ogg",
      "durationSec": 2.952
    },
    {
      "index": 13,
      "text": "感受差異。",
      "file": "c013.ogg",
      "durationSec": 3.456
    },
    {
      "index": 14,
      "text": "[暫停：21]",
      "file": "c014.ogg",
      "durationSec": 4.464
    },
    {
      "index": 15,
      "text": "收緊小腿。",
      "file": "c015.ogg",
      "durationSec": 3.72
    },
    {
      "index": 16,
      "text": "抓住。",
      "file": "c016.ogg",
      "durationSec": 3.12
    },
    {
      "index": 17,
      "text": "[暫停：19]",
      "file": "c017.ogg",
      "durationSec": 4.488
    },
    {
      "index": 18,
      "text": "釋出。",
      "file": "c018.ogg",
      "durationSec": 2.952
    },
    {
      "index": 19,
      "text": "讓小腿變得沉重。",
      "file": "c019.ogg",
      "durationSec": 4.44
    },
    {
      "index": 20,
      "text": "[暫停：21]",
      "file": "c020.ogg",
      "durationSec": 4.464
    },
    {
      "index": 21,
      "text": "收緊大腿。",
      "file": "c021.ogg",
      "durationSec": 3.6
    },
    {
      "index": 22,
      "text": "抓住。",
      "file": "c022.ogg",
      "durationSec": 3.12
    },
    {
      "index": 23,
      "text": "[暫停：19]",
      "file": "c023.ogg",
      "durationSec": 4.488
    },
    {
      "index": 24,
      "text": "釋出。",
      "file": "c024.ogg",
      "durationSec": 2.952
    },
    {
      "index": 25,
      "text": "腿軟了柔軟的臀部。",
      "file": "c025.ogg",
      "durationSec": 4.368
    },
    {
      "index": 26,
      "text": "[暫停：21]",
      "file": "c026.ogg",
      "durationSec": 4.464
    },
    {
      "index": 27,
      "text": "輕輕地將腹部收攏。",
      "file": "c027.ogg",
      "durationSec": 4.56
    },
    {
      "index": 28,
      "text": "保持無壓力。",
      "file": "c028.ogg",
      "durationSec": 3.672
    },
    {
      "index": 29,
      "text": "[暫停：19]",
      "file": "c029.ogg",
      "durationSec": 4.488
    },
    {
      "index": 30,
      "text": "釋出。",
      "file": "c030.ogg",
      "durationSec": 2.952
    },
    {
