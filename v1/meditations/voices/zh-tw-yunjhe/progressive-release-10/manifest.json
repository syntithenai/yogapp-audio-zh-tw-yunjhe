    },
    {
      "index": 44,
      "text": "[暫停：21]",
      "file": "c044.ogg",
      "durationSec": 4.464
    },
    {
      "index": 45,
      "text": "輕輕揉捏臉部。眼睛、眉毛、下巴。",
      "file": "c045.ogg",
      "durationSec": 9.816
    },
    {
      "index": 46,
