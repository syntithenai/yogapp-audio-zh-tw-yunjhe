{
  "id": "anxiety-ease-10",
  "voiceId": "zh-tw-yunjhe",
  "edgeVoice": "zh-TW-YunJheNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 254,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "需要時間到達。",
      "file": "c001.ogg",
      "durationSec": 4.104
    },
    {
      "index": 2,
      "text": "在支撐下坐下或躺下。",
      "file": "c002.ogg",
      "durationSec": 4.992
    },
    {
      "index": 3,
      "text": "如果感覺安全，請閉上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.976
    },
    {
      "index": 4,
      "text": "感受與地面的接觸。",
      "file": "c004.ogg",
      "durationSec": 4.632
    },
    {
      "index": 5,
      "text": "緩慢吸氣。",
      "file": "c005.ogg",
      "durationSec": 3.528
    },
    {
      "index": 6,
      "text": "呼氣時間更長。",
      "file": "c006.ogg",
      "durationSec": 4.128
    },
    {
      "index": 7,
      "text": "[暫停：20]",
      "file": "c007.ogg",
      "durationSec": 4.44
    },
    {
      "index": 8,
      "text": "再次。",
      "file": "c008.ogg",
      "durationSec": 3.096
    },
    {
      "index": 9,
      "text": "[暫停：20]",
      "file": "c009.ogg",
      "durationSec": 4.44
    },
    {
      "index": 10,
      "text": "讓肩膀下垂。",
      "file": "c010.ogg",
      "durationSec": 3.936
    },
    {
      "index": 11,
      "text": "讓腹部變軟。",
      "file": "c011.ogg",
      "durationSec": 3.6
    },
    {
      "index": 12,
      "text": "[暫停：25]",
      "file": "c012.ogg",
      "durationSec": 4.488
    },
    {
      "index": 13,
      "text": "焦慮可能仍然存在。這是允許的。",
      "file": "c013.ogg",
      "durationSec": 8.04
    },
    {
      "index": 14,
      "text": "我們並不與之抗爭。我們正在與身體交朋友。",
      "file": "c014.ogg",
      "durationSec": 9.048
    },
    {
      "index": 15,
      "text": "[暫停：25]",
      "file": "c015.ogg",
      "durationSec": 4.488
    },
    {
      "index": 16,
      "text": "將腳輕輕壓入地板。",
      "file": "c016.ogg",
      "durationSec": 4.608
    },
    {
      "index": 17,
      "text": "感覺地板向後壓。",
      "file": "c017.ogg",
      "durationSec": 4.08
    },
    {
      "index": 18,
      "text": "[暫停：25]",
      "file": "c018.ogg",
      "durationSec": 4.488
    },
    {
      "index": 19,
      "text": "說出三種你閉上眼睛或溫柔凝視時可以看到的東西。",
      "file": "c019.ogg",
      "durationSec": 8.184
    },
    {
      "index": 20,
      "text": "黑暗的。光。眼瞼的形狀。",
      "file": "c020.ogg",
      "durationSec": 9.312
    },
    {
      "index": 21,
      "text": "[暫停：25]",
      "file": "c021.ogg",
      "durationSec": 4.488
    },
    {
      "index": 22,
      "text": "說出三種感覺。",
      "file": "c022.ogg",
      "durationSec": 4.344
    },
    {
      "index": 23,
      "text": "衣服。溫度。氣息。",
      "file": "c023.ogg",
      "durationSec": 8.976
    },
    {
      "index": 24,
      "text": "[暫停：25]",
      "file": "c024.ogg",
      "durationSec": 4.488
    },
    {
      "index": 25,
      "text": "吸氣四次。",
      "file": "c025.ogg",
      "durationSec": 3.6
    },
    {
      "index": 26,
      "text": "堅持兩個。",
      "file": "c026.ogg",
      "durationSec": 3.456
    },
    {
      "index": 27,
      "text": "六人出局。",
      "file": "c027.ogg",
      "durationSec": 3.552
    },
    {
      "index": 28,
      "text": "[暫停：20]",
      "file": "c028.ogg",
      "durationSec": 4.44
    },
    {
      "index": 29,
      "text": "再次。",
      "file": "c029.ogg",
      "durationSec": 3.096
    },
    {
      "index": 30,
      "text": "[暫停：25]",
      "file": "c030.ogg",
      "durationSec": 4.488
    },
    {
      "index": 31,
      "text": "將手放在胸部或腹部。",
      "file": "c031.ogg",
      "durationSec": 5.04
    },
    {
      "index": 32,
      "text": "感受手下的運動。",
      "file": "c032.ogg",
      "durationSec": 4.32
    },
    {
      "index": 33,
      "text": "輕聲說：現在，我正在呼吸。",
      "file": "c033.ogg",
      "durationSec": 6.528
    },
    {
      "index": 34,
      "text": "[停頓：30]",
      "file": "c034.ogg",
      "durationSec": 4.488
    },
    {
      "index": 35,
      "text": "如果頭腦飛速前進，感謝它試圖保護你。",
      "file": "c035.ogg",
      "durationSec": 7.152
    },
    {
      "index": 36,
      "text": "然後回到這個呼吸。",
      "file": "c036.ogg",
      "durationSec": 4.608
    },
    {
      "index": 37,
      "text": "[暫停：41]",
      "file": "c037.ogg",
      "durationSec": 4.536
    },
    {
      "index": 38,
      "text": "掃描臉部。軟化。",
      "file": "c038.ogg",
      "durationSec": 6.552
    },
    {
      "index": 39,
      "text": "掃描雙手。軟化。",
      "file": "c039.ogg",
      "durationSec": 6.528
    },
    {
      "index": 40,
      "text": "[停頓：30]",
      "file": "c040.ogg",
      "durationSec": 4.488
    },
    {
      "index": 41,
      "text": "以更長的呼氣節奏休息。",
      "file": "c041.ogg",
      "durationSec": 5.184
    },
    {
      "index": 42,
      "text": "[暫停：76]",
      "file": "c042.ogg",
      "durationSec": 4.56
    },
    {
      "index": 43,
      "text": "你給了神經系統更廣闊的海岸。",
      "file": "c043.ogg",
      "durationSec": 5.856
    },
    {
      "index": 44,
      "text": "[暫停：41]",
      "file": "c044.ogg",
      "durationSec": 4.536
    },
    {
      "index": 45,
      "text": "[停頓：30]",
      "file": "c045.ogg",
      "durationSec": 4.488
    },
    {
      "index": 46,
      "text": "開始加深呼吸。",
      "file": "c046.ogg",
      "durationSec": 4.056
    },
    {
      "index": 47,
      "text": "再次感受一下房間。",
      "file": "c047.ogg",
      "durationSec": 4.296
    },
    {
      "index": 48,
      "text": "擺動手指和腳趾。",
      "file": "c048.ogg",
      "durationSec": 4.44
    },
    {
      "index": 49,
      "text": "準備好後，睜開眼睛。",
      "file": "c049.ogg",
      "durationSec": 5.304
    },
    {
      "index": 50,
      "text": "慢慢地進入接下來的事情。",
      "file": "c050.ogg",
      "durationSec": 5.04
    }
  ]
}
