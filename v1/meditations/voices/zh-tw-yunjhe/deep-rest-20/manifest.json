{
  "id": "deep-rest-20",
  "voiceId": "zh-tw-yunjhe",
  "edgeVoice": "zh-TW-YunJheNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 478,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎來到深度休息的練習。",
      "file": "c000.ogg",
      "durationSec": 5.64
    },
    {
      "index": 1,
      "text": "如果可以的話，仰臥。",
      "file": "c001.ogg",
      "durationSec": 5.184
    },
    {
      "index": 2,
      "text": "如果有幫助的話，支撐頭部和膝蓋。",
      "file": "c002.ogg",
      "durationSec": 6.792
    },
    {
      "index": 3,
      "text": "將手臂放在身體兩側，手掌柔軟。",
      "file": "c003.ogg",
      "durationSec": 6.984
    },
    {
      "index": 4,
      "text": "瞑。",
      "file": "c004.ogg",
      "durationSec": 2.856
    },
    {
      "index": 5,
      "text": "沒有其他地方可去了。",
      "file": "c005.ogg",
      "durationSec": 4.608
    },
    {
      "index": 6,
      "text": "[暫停：23]",
      "file": "c006.ogg",
      "durationSec": 4.416
    },
    {
      "index": 7,
      "text": "感受與地板或床的接觸點。",
      "file": "c007.ogg",
      "durationSec": 5.52
    },
    {
      "index": 8,
      "text": "高跟鞋。臀部。肩胛骨。頭。",
      "file": "c008.ogg",
      "durationSec": 11.976
    },
    {
      "index": 9,
      "text": "讓身體被握住。",
      "file": "c009.ogg",
      "durationSec": 3.984
    },
    {
      "index": 10,
      "text": "[暫停：23]",
      "file": "c010.ogg",
      "durationSec": 4.416
    },
    {
      "index": 11,
      "text": "注意自然的呼吸。",
      "file": "c011.ogg",
      "durationSec": 3.96
    },
    {
      "index": 12,
      "text": "不需要改變它。",
      "file": "c012.ogg",
      "durationSec": 3.648
    },
    {
      "index": 13,
      "text": "吸氣到來。",
      "file": "c013.ogg",
      "durationSec": 3.504
    },
    {
      "index": 14,
      "text": "呼氣葉子。",
      "file": "c014.ogg",
      "durationSec": 3.456
    },
    {
      "index": 15,
      "text": "[暫停：25]",
      "file": "c015.ogg",
      "durationSec": 4.488
    },
    {
      "index": 16,
      "text": "如果頭腦很忙，這是允許的。",
      "file": "c016.ogg",
      "durationSec": 5.808
    },
    {
      "index": 17,
      "text": "無論如何你都可以休息。",
      "file": "c017.ogg",
      "durationSec": 4.968
    },
    {
      "index": 18,
      "text": "只要繼續迴歸感覺即可。",
      "file": "c018.ogg",
      "durationSec": 5.088
    },
    {
      "index": 19,
      "text": "[暫停：23]",
      "file": "c019.ogg",
      "durationSec": 4.416
    },
    {
      "index": 20,
      "text": "將意識帶到右腳。",
      "file": "c020.ogg",
      "durationSec": 4.32
    },
    {
      "index": 21,
      "text": "腳趾。唯一。腳跟。",
      "file": "c021.ogg",
      "durationSec": 8.76
    },
    {
      "index": 22,
      "text": "[暫停：21]",
      "file": "c022.ogg",
      "durationSec": 4.464
    },
    {
      "index": 23,
      "text": "右小腿。",
      "file": "c023.ogg",
      "durationSec": 3.264
    },
    {
      "index": 24,
      "text": "膝蓋。",
      "file": "c024.ogg",
      "durationSec": 3.096
    },
    {
      "index": 25,
      "text": "大腿。",
      "file": "c025.ogg",
      "durationSec": 2.976
    },
    {
      "index": 26,
      "text": "[暫停：21]",
      "file": "c026.ogg",
      "durationSec": 4.464
    },
    {
      "index": 27,
      "text": "右髖部。",
      "file": "c027.ogg",
      "durationSec": 3.24
    },
    {
      "index": 28,
      "text": "整條右腿，沉重而安靜。",
      "file": "c028.ogg",
      "durationSec": 5.568
    },
    {
      "index": 29,
      "text": "[暫停：23]",
      "file": "c029.ogg",
      "durationSec": 4.416
    },
    {
      "index": 30,
      "text": "左腳。",
      "file": "c030.ogg",
      "durationSec": 2.976
    },
    {
      "index": 31,
      "text": "腳趾。唯一。腳跟。",
      "file": "c031.ogg",
      "durationSec": 8.76
    },
    {
      "index": 32,
      "text": "[暫停：21]",
      "file": "c032.ogg",
      "durationSec": 4.464
    },
    {
      "index": 33,
      "text": "左小腿。",
      "file": "c033.ogg",
      "durationSec": 3.336
    },
    {
      "index": 34,
      "text": "膝蓋。",
      "file": "c034.ogg",
      "durationSec": 3.096
    },
    {
      "index": 35,
      "text": "大腿。",
      "file": "c035.ogg",
      "durationSec": 2.976
    },
    {
      "index": 36,
      "text": "[暫停：21]",
      "file": "c036.ogg",
      "durationSec": 4.464
    },
    {
      "index": 37,
      "text": "左臀部。",
      "file": "c037.ogg",
      "durationSec": 3.288
    },
    {
      "index": 38,
      "text": "整條左腿，沉重而安靜。",
      "file": "c038.ogg",
      "durationSec": 5.592
    },
    {
      "index": 39,
      "text": "[暫停：23]",
      "file": "c039.ogg",
      "durationSec": 4.416
    },
    {
      "index": 40,
      "text": "骨盆和低腹部。",
      "file": "c040.ogg",
      "durationSec": 4.2
    },
    {
      "index": 41,
      "text": "柔軟的。",
      "file": "c041.ogg",
      "durationSec": 3.168
    },
    {
      "index": 42,
      "text": "[暫停：21]",
      "file": "c042.ogg",
      "durationSec": 4.464
    },
    {
      "index": 43,
      "text": "胸部起伏。",
      "file": "c043.ogg",
      "durationSec": 3.648
    },
    {
      "index": 44,
      "text": "心空間開闊、輕鬆。",
      "file": "c044.ogg",
      "durationSec": 5.04
    },
    {
      "index": 45,
      "text": "[暫停：23]",
      "file": "c045.ogg",
      "durationSec": 4.416
    },
    {
      "index": 46,
      "text": "右手。",
      "file": "c046.ogg",
      "durationSec": 2.976
    },
    {
      "index": 47,
      "text": "手指。棕櫚。手腕。",
      "file": "c047.ogg",
      "durationSec": 9.192
    },
    {
      "index": 48,
      "text": "[暫停：14]",
      "file": "c048.ogg",
      "durationSec": 4.488
    },
    {
      "index": 49,
      "text": "右臂。彎頭。肩膀。",
      "file": "c049.ogg",
      "durationSec": 8.856
    },
    {
      "index": 50,
      "text": "[暫停：21]",
      "file": "c050.ogg",
      "durationSec": 4.464
    },
    {
      "index": 51,
      "text": "左手。",
      "file": "c051.ogg",
      "durationSec": 3.024
    },
    {
      "index": 52,
      "text": "手指。棕櫚。手腕。",
      "file": "c052.ogg",
      "durationSec": 9.192
    },
    {
      "index": 53,
      "text": "[暫停：14]",
      "file": "c053.ogg",
      "durationSec": 4.488
    },
    {
      "index": 54,
      "text": "左臂。彎頭。肩膀。",
      "file": "c054.ogg",
      "durationSec": 8.904
    },
    {
      "index": 55,
      "text": "[暫停：23]",
      "file": "c055.ogg",
      "durationSec": 4.416
    },
    {
      "index": 56,
      "text": "喉嚨軟。",
      "file": "c056.ogg",
      "durationSec": 3.216
    },
    {
      "index": 57,
      "text": "下巴張開。",
      "file": "c057.ogg",
      "durationSec": 3.6
    },
    {
      "index": 58,
      "text": "舌頭休息。",
      "file": "c058.ogg",
      "durationSec": 3.744
    },
    {
      "index": 59,
      "text": "[暫停：21]",
      "file": "c059.ogg",
      "durationSec": 4.464
    },
    {
      "index": 60,
      "text": "眼睛擱在眼窩裡。",
      "file": "c060.ogg",
      "durationSec": 4.224
    },
    {
      "index": 61,
      "text": "額頭光滑。",
      "file": "c061.ogg",
      "durationSec": 3.624
    },
    {
      "index": 62,
      "text": "頭皮和頭頂。",
      "file": "c062.ogg",
      "durationSec": 4.008
    },
    {
      "index": 63,
      "text": "[暫停：23]",
      "file": "c063.ogg",
      "durationSec": 4.416
    },
    {
      "index": 64,
      "text": "感覺整個身體是一片寂靜的場域。",
      "file": "c064.ogg",
      "durationSec": 5.76
    },
    {
      "index": 65,
      "text": "呼吸像平靜的潮水一樣穿過它。",
      "file": "c065.ogg",
      "durationSec": 5.856
    },
    {
      "index": 66,
      "text": "[暫停：62]",
      "file": "c066.ogg",
      "durationSec": 4.56
    },
    {
      "index": 67,
      "text": "與整個身體保持一致。",
      "file": "c067.ogg",
      "durationSec": 4.512
    },
    {
      "index": 68,
      "text": "[暫停：105]",
      "file": "c068.ogg",
      "durationSec": 4.8
    },
    {
      "index": 69,
      "text": "柔軟的。寬敞。仍然。",
      "file": "c069.ogg",
      "durationSec": 9.096
    },
    {
      "index": 70,
      "text": "[暫停：55]",
      "file": "c070.ogg",
      "durationSec": 4.584
    },
    {
      "index": 71,
      "text": "如果有一個念頭出現，讓它像雲一樣過去。",
      "file": "c071.ogg",
      "durationSec": 7.128
    },
    {
      "index": 72,
      "text": "[停頓：50]",
      "file": "c072.ogg",
      "durationSec": 4.44
    },
    {
      "index": 73,
      "text": "回到被抱著的感覺。",
      "file": "c073.ogg",
      "durationSec": 4.584
    },
    {
      "index": 74,
      "text": "[暫停：55]",
      "file": "c074.ogg",
      "durationSec": 4.584
    },
    {
      "index": 75,
      "text": "在這裡休息。",
      "file": "c075.ogg",
      "durationSec": 3.768
    },
    {
      "index": 76,
      "text": "沒什麼可解決的。",
      "file": "c076.ogg",
      "durationSec": 4.368
    },
    {
      "index": 77,
      "text": "沒有什麼要完成的。",
      "file": "c077.ogg",
      "durationSec": 4.392
    },
    {
      "index": 78,
      "text": "[暫停：110]",
      "file": "c078.ogg",
      "durationSec": 4.944
    },
    {
      "index": 79,
      "text": "如果你漂移，那很好。",
      "file": "c079.ogg",
      "durationSec": 5.136
    },
    {
      "index": 80,
      "text": "如果你保持覺知，那也很好。",
      "file": "c080.ogg",
      "durationSec": 5.688
    },
    {
      "index": 81,
      "text": "兩人都在休息。",
      "file": "c081.ogg",
      "durationSec": 4.272
    },
    {
      "index": 82,
      "text": "[暫停：130]",
      "file": "c082.ogg",
      "durationSec": 5.016
    },
    {
      "index": 83,
      "text": "休息。",
      "file": "c083.ogg",
      "durationSec": 3.264
    },
    {
      "index": 84,
      "text": "[暫停：115]",
      "file": "c084.ogg",
      "durationSec": 5.016
    },
    {
      "index": 85,
      "text": "再次開始注意呼吸。",
      "file": "c085.ogg",
      "durationSec": 4.464
    },
    {
      "index": 86,
      "text": "現在更生動一些。",
      "file": "c086.ogg",
      "durationSec": 4.32
    },
    {
      "index": 87,
      "text": "[暫停：23]",
      "file": "c087.ogg",
      "durationSec": 4.416
    },
    {
      "index": 88,
      "text": "感受你周圍的房間。",
      "file": "c088.ogg",
      "durationSec": 4.32
    },
    {
      "index": 89,
      "text": "聲音近又遠。",
      "file": "c089.ogg",
      "durationSec": 3.816
    },
    {
      "index": 90,
      "text": "[暫停：21]",
      "file": "c090.ogg",
      "durationSec": 4.464
    },
    {
      "index": 91,
      "text": "動動手指。",
      "file": "c091.ogg",
      "durationSec": 3.432
    },
    {
      "index": 92,
      "text": "扭動腳趾。",
      "file": "c092.ogg",
      "durationSec": 3.528
    },
    {
      "index": 93,
      "text": "如果願意，可以轉動手腕和腳踝。",
      "file": "c093.ogg",
      "durationSec": 6.768
    },
    {
      "index": 94,
      "text": "[暫停：21]",
      "file": "c094.ogg",
      "durationSec": 4.464
    },
    {
      "index": 95,
      "text": "深吸一口氣。",
      "file": "c095.ogg",
      "durationSec": 3.816
    },
    {
      "index": 96,
      "text": "並長長地嘆了口氣。",
      "file": "c096.ogg",
      "durationSec": 4.368
    },
    {
      "index": 97,
      "text": "準備好後，睜開眼睛。",
      "file": "c097.ogg",
      "durationSec": 5.304
    },
    {
      "index": 98,
      "text": "慢慢返回。",
      "file": "c098.ogg",
      "durationSec": 3.528
    },
    {
      "index": 99,
      "text": "隨身攜帶一點這種安靜。",
      "file": "c099.ogg",
      "durationSec": 5.232
    }
  ]
}
