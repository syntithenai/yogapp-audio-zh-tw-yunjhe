{
  "id": "cool-anger-5",
  "voiceId": "zh-tw-yunjhe",
  "edgeVoice": "zh-TW-YunJheNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 118,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "如果存在憤怒或惱怒，歡迎您來到這裡。",
      "file": "c001.ogg",
      "durationSec": 7.032
    },
    {
      "index": 2,
      "text": "你不需要讓它消失。",
      "file": "c002.ogg",
      "durationSec": 4.56
    },
    {
      "index": 3,
      "text": "只要給它更多的空間。",
      "file": "c003.ogg",
      "durationSec": 4.416
    },
    {
      "index": 4,
      "text": "感覺腳。",
      "file": "c004.ogg",
      "durationSec": 3.192
    },
    {
      "index": 5,
      "text": "[暫停：25]",
      "file": "c005.ogg",
      "durationSec": 4.488
    },
    {
      "index": 6,
      "text": "吸氣四次。",
      "file": "c006.ogg",
      "durationSec": 3.6
    },
    {
      "index": 7,
      "text": "呼氣六到八次。",
      "file": "c007.ogg",
      "durationSec": 4.2
    },
    {
      "index": 8,
      "text": "較長的呼氣可以使系統冷卻。",
      "file": "c008.ogg",
      "durationSec": 5.688
    },
    {
      "index": 9,
      "text": "[暫停：33]",
      "file": "c009.ogg",
      "durationSec": 4.512
    },
    {
      "index": 10,
      "text": "再次。",
      "file": "c010.ogg",
      "durationSec": 3.096
    },
    {
      "index": 11,
      "text": "[暫停：33]",
      "file": "c011.ogg",
      "durationSec": 4.512
    },
    {
      "index": 12,
      "text": "在不講故事的情況下說出熱度。",
      "file": "c012.ogg",
      "durationSec": 5.904
    },
    {
      "index": 13,
      "text": "胸中發熱。下巴緊繃。思維敏捷。",
      "file": "c013.ogg",
      "durationSec": 10.512
    },
    {
      "index": 14,
      "text": "[暫停：41]",
      "file": "c014.ogg",
      "durationSec": 4.536
    },
    {
      "index": 15,
      "text": "軟化雙手。",
      "file": "c015.ogg",
      "durationSec": 3.528
    },
    {
      "index": 16,
      "text": "放下肩膀。",
      "file": "c016.ogg",
      "durationSec": 3.624
    },
    {
      "index": 17,
      "text": "[暫停：33]",
      "file": "c017.ogg",
      "durationSec": 4.512
    },
    {
      "index": 18,
      "text": "您可以稍後從更清晰的地方回覆。",
      "file": "c018.ogg",
      "durationSec": 6.456
    },
    {
      "index": 19,
      "text": "現在，呼吸。",
      "file": "c019.ogg",
      "durationSec": 4.296
    },
    {
      "index": 20,
      "text": "[暫停：45]",
      "file": "c020.ogg",
      "durationSec": 4.632
    },
    {
      "index": 21,
      "text": "再輕鬆地吸一口氣。",
      "file": "c021.ogg",
      "durationSec": 4.44
    },
    {
      "index": 22,
      "text": "動動手指。",
      "file": "c022.ogg",
      "durationSec": 3.432
    },
    {
      "index": 23,
      "text": "準備好後，睜開眼睛。",
      "file": "c023.ogg",
      "durationSec": 5.304
    },
    {
      "index": 24,
      "text": "隨身攜帶一點這個。",
      "file": "c024.ogg",
      "durationSec": 4.56
    }
  ]
}
