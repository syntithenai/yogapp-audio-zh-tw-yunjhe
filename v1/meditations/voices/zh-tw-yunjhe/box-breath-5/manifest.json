  "totalSec": 204,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "找一個舒適的座位，或者如果感覺好一點的話就躺下來。",
      "file": "c001.ogg",
      "durationSec": 8.856
    },
    {
      "index": 2,
      "text": "讓雙手休息一下。",
      "file": "c002.ogg",
      "durationSec": 4.32
    },
    {
      "index": 3,
      "text": "軟化眼睛，或閉上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.448
    },
    {
      "index": 4,
      "text": "緩慢吸氣。",
      "file": "c004.ogg",
      "durationSec": 3.528
    },
    {
      "index": 5,
      "text": "並且呼氣時間更長。",
      "file": "c005.ogg",
      "durationSec": 4.656
    },
    {
      "index": 6,
      "text": "我們將在一個簡單的盒子裡呼吸。",
      "file": "c006.ogg",
      "durationSec": 5.568
    },
    {
      "index": 7,
      "text": "四人入。堅持四個。四人出局。堅持四個。",
      "file": "c007.ogg",
      "durationSec": 13.272
    },
    {
      "index": 8,
      "text": "保持溫柔。切勿緊張。",
      "file": "c008.ogg",
      "durationSec": 6.792
    },
    {
      "index": 9,
      "text": "[暫停：20]",
      "file": "c009.ogg",
      "durationSec": 4.44
    },
    {
      "index": 10,
      "text": "吸入。二。三。四。",
      "file": "c010.ogg",
      "durationSec": 11.04
    },
    {
      "index": 11,
      "text": "抓住。二。三。四。",
      "file": "c011.ogg",
      "durationSec": 11.064
    },
    {
      "index": 12,
      "text": "呼氣。二。三。四。",
      "file": "c012.ogg",
      "durationSec": 10.992
    },
    {
      "index": 13,
      "text": "抓住。二。三。四。",
      "file": "c013.ogg",
      "durationSec": 11.064
    },
    {
      "index": 14,
      "text": "[暫停：20]",
      "file": "c014.ogg",
      "durationSec": 4.44
    },
    {
      "index": 15,
      "text": "再次。吸入。",
      "file": "c015.ogg",
      "durationSec": 6.048
    },
    {
      "index": 16,
      "text": "抓住。",
      "file": "c016.ogg",
      "durationSec": 3.12
    },
    {
      "index": 17,
      "text": "呼氣。",
      "file": "c017.ogg",
      "durationSec": 3.072
    },
    {
      "index": 18,
      "text": "抓住。",
      "file": "c018.ogg",
      "durationSec": 3.12
    },
    {
      "index": 19,
      "text": "[暫停：26]",
      "file": "c019.ogg",
      "durationSec": 4.584
    },
    {
      "index": 20,
      "text": "繼續自己數數幾輪。",
      "file": "c020.ogg",
      "durationSec": 4.56
    },
    {
      "index": 21,
      "text": "如果四個太長，請使用三個。",
      "file": "c021.ogg",
      "durationSec": 5.952
    },
    {
      "index": 22,
      "text": "[暫停：45]",
      "file": "c022.ogg",
      "durationSec": 4.632
    },
    {
      "index": 23,
      "text": "再來一盒滿滿的。",
      "file": "c023.ogg",
      "durationSec": 4.224
    },
    {
      "index": 24,
      "text": "吸入。",
      "file": "c024.ogg",
      "durationSec": 3.096
    },
    {
      "index": 25,
      "text": "抓住。",
      "file": "c025.ogg",
      "durationSec": 3.12
    },
    {
      "index": 26,
      "text": "呼氣。",
      "file": "c026.ogg",
      "durationSec": 3.072
    },
    {
      "index": 27,
      "text": "抓住。",
      "file": "c027.ogg",
      "durationSec": 3.12
    },
    {
      "index": 28,
      "text": "[暫停：26]",
      "file": "c028.ogg",
      "durationSec": 4.584
    },
    {
      "index": 29,
      "text": "迴歸自然呼吸。",
      "file": "c029.ogg",
      "durationSec": 3.936
    },
    {
      "index": 30,
      "text": "注意接下來的安靜。",
      "file": "c030.ogg",
      "durationSec": 4.344
    },
    {
      "index": 31,
      "text": "[暫停：33]",
      "file": "c031.ogg",
      "durationSec": 4.512
    },
    {
      "index": 32,
      "text": "在這裡休息。",
      "file": "c032.ogg",
      "durationSec": 3.768
    },
    {
      "index": 33,
      "text": "[暫停：33]",
      "file": "c033.ogg",
      "durationSec": 4.512
    },
    {
      "index": 34,
      "text": "再輕鬆地吸一口氣。",
      "file": "c034.ogg",
      "durationSec": 4.44
    },
    {
      "index": 35,
      "text": "動動手指。",
      "file": "c035.ogg",
      "durationSec": 3.432
    },
    {
      "index": 36,
      "text": "準備好後，睜開眼睛。",
      "file": "c036.ogg",
      "durationSec": 5.304
    },
    {
      "index": 37,
      "text": "隨身攜帶一點這個。",
      "file": "c037.ogg",
      "durationSec": 4.56
    }
  ]
}
