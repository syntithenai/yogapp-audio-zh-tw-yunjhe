{
  "id": "calm-arrive",
  "voiceId": "zh-tw-yunjhe",
  "edgeVoice": "zh-TW-YunJheNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 111,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "稍等片刻即可到達。",
      "file": "c001.ogg",
      "durationSec": 4.896
    },
    {
      "index": 2,
      "text": "找一個舒適的座位，或者如果感覺好一點的話就躺下來。",
      "file": "c002.ogg",
      "durationSec": 8.856
    },
    {
      "index": 3,
      "text": "讓你的雙手休息一下。",
      "file": "c003.ogg",
      "durationSec": 4.56
    },
    {
      "index": 4,
      "text": "讓你的眼睛閉上，或者軟化你的目光。",
      "file": "c004.ogg",
      "durationSec": 6.552
    },
    {
      "index": 5,
      "text": "請注意，您在這裡。",
      "file": "c005.ogg",
      "durationSec": 5.112
    },
    {
      "index": 6,
      "text": "現在沒什麼可修復的。",
      "file": "c006.ogg",
      "durationSec": 4.824
    },
    {
      "index": 7,
      "text": "沒有什麼要完成的。",
      "file": "c007.ogg",
      "durationSec": 4.392
    },
    {
      "index": 8,
      "text": "透過鼻子緩慢吸氣。",
      "file": "c008.ogg",
      "durationSec": 4.56
    },
    {
      "index": 9,
      "text": "並且呼氣時間更長。",
      "file": "c009.ogg",
      "durationSec": 4.656
    },
    {
      "index": 10,
      "text": "再次。輕輕吸氣。",
      "file": "c010.ogg",
      "durationSec": 6.6
    },
    {
      "index": 11,
      "text": "輕輕呼氣。",
      "file": "c011.ogg",
      "durationSec": 3.672
    },
    {
      "index": 12,
      "text": "感受身體的重量受到支撐。",
      "file": "c012.ogg",
      "durationSec": 5.376
    },
    {
      "index": 13,
      "text": "地板、椅子、地球支撐著你。",
      "file": "c013.ogg",
      "durationSec": 6.048
    },
    {
      "index": 14,
      "text": "如果思緒遊離，那也沒關係。",
      "file": "c014.ogg",
      "durationSec": 5.736
    },
    {
      "index": 15,
      "text": "只要注意，然後回到這個呼吸。",
      "file": "c015.ogg",
      "durationSec": 6.024
    },
    {
      "index": 16,
      "text": "吸氣。到達。",
      "file": "c016.ogg",
      "durationSec": 5.976
    },
    {
      "index": 17,
      "text": "呼氣。定居。",
      "file": "c017.ogg",
      "durationSec": 5.832
    },
    {
      "index": 18,
      "text": "又輕鬆了一口氣。",
      "file": "c018.ogg",
      "durationSec": 4.104
    },
    {
      "index": 19,
      "text": "準備好後，睜開眼睛。",
      "file": "c019.ogg",
      "durationSec": 5.304
    },
    {
      "index": 20,
      "text": "隨身攜帶這份安靜。",
      "file": "c020.ogg",
      "durationSec": 4.752
    }
  ]
}
