{
  "id": "self-compassion-10",
  "voiceId": "zh-tw-yunjhe",
  "edgeVoice": "zh-TW-YunJheNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 185,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 3.144
    },
    {
      "index": 1,
      "text": "需要時間到達。",
      "file": "c001.ogg",
      "durationSec": 4.104
    },
    {
      "index": 2,
      "text": "在支撐下坐下或躺下。",
      "file": "c002.ogg",
      "durationSec": 4.992
    },
    {
      "index": 3,
      "text": "如果感覺安全，請閉上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.976
    },
    {
      "index": 4,
      "text": "感受與地面的接觸。",
      "file": "c004.ogg",
      "durationSec": 4.632
    },
    {
      "index": 5,
      "text": "緩慢吸氣。",
      "file": "c005.ogg",
      "durationSec": 3.528
    },
    {
      "index": 6,
      "text": "呼氣時間更長。",
      "file": "c006.ogg",
      "durationSec": 4.128
    },
    {
      "index": 7,
      "text": "[暫停：26]",
      "file": "c007.ogg",
      "durationSec": 4.584
    },
    {
      "index": 8,
      "text": "再次。",
      "file": "c008.ogg",
      "durationSec": 3.096
    },
    {
      "index": 9,
      "text": "[暫停：26]",
      "file": "c009.ogg",
      "durationSec": 4.584
    },
    {
      "index": 10,
      "text": "讓肩膀下垂。",
      "file": "c010.ogg",
      "durationSec": 3.936
    },
    {
      "index": 11,
      "text": "讓腹部變軟。",
      "file": "c011.ogg",
      "durationSec": 3.6
    },
    {
      "index": 12,
      "text": "[暫停：32]",
      "file": "c012.ogg",
      "durationSec": 4.632
    },
    {
      "index": 13,
      "text": "把手放在心上，如果有幫助的話。",
      "file": "c013.ogg",
      "durationSec": 6.408
    },
    {
      "index": 14,
      "text": "不加評判地注意你的狀態。",
      "file": "c014.ogg",
      "durationSec": 4.992
    },
    {
      "index": 15,
      "text": "[暫停：32]",
      "file": "c015.ogg",
      "durationSec": 4.632
    },
    {
      "index": 16,
      "text": "這是一個痛苦的時刻，或者說是普通人類的壓力時刻。",
      "file": "c016.ogg",
      "durationSec": 8.352
    },
    {
      "index": 17,
      "text": "其他人也有這樣的感覺。",
      "file": "c017.ogg",
      "durationSec": 5.04
    },
    {
      "index": 18,
      "text": "[暫停：39]",
      "file": "c018.ogg",
      "durationSec": 4.752
    },
    {
      "index": 19,
      "text": "願此刻我善待自己。",
      "file": "c019.ogg",
      "durationSec": 4.68
    },
    {
      "index": 20,
      "text": "[暫停：32]",
      "file": "c020.ogg",
      "durationSec": 4.632
    },
    {
      "index": 21,
      "text": "願我接受現在的自己。",
      "file": "c021.ogg",
      "durationSec": 4.728
    },
    {
      "index": 22,
      "text": "[暫停：32]",
      "file": "c022.ogg",
      "durationSec": 4.632
    },
    {
      "index": 23,
      "text": "願我給予自己我所需要的同情心。",
      "file": "c023.ogg",
      "durationSec": 5.76
    },
    {
      "index": 24,
      "text": "[暫停：39]",
      "file": "c024.ogg",
      "durationSec": 4.752
    },
    {
      "index": 25,
      "text": "重複落地的短語。留下那些不這樣做的。",
      "file": "c025.ogg",
      "durationSec": 0.36
    },
    {
      "index": 26,
      "text": "[暫停：52]",
      "file": "c026.ogg",
      "durationSec": 4.536
    },
    {
      "index": 27,
      "text": "想象一下，像一位明智的朋友一樣對自己說話。",
      "file": "c027.ogg",
      "durationSec": 8.016
    },
    {
      "index": 28,
      "text": "他們會用什麼語氣？",
      "file": "c028.ogg",
      "durationSec": 4.224
    },
    {
      "index": 29,
      "text": "現在就給自己這樣的語氣。",
      "file": "c029.ogg",
      "durationSec": 5.256
    },
    {
      "index": 30,
      "text": "[暫停：65]",
      "file": "c030.ogg",
      "durationSec": 4.608
    },
    {
      "index": 31,
      "text": "吸入善意。",
      "file": "c031.ogg",
      "durationSec": 3.48
    },
    {
      "index": 32,
      "text": "撥出粗重的氣息。",
      "file": "c032.ogg",
      "durationSec": 4.44
    },
    {
      "index": 33,
      "text": "[暫停：78]",
      "file": "c033.ogg",
      "durationSec": 4.272
    },
    {
      "index": 34,
      "text": "[暫停：39]",
      "file": "c034.ogg",
      "durationSec": 4.752
    },
    {
      "index": 35,
      "text": "開始加深呼吸。",
      "file": "c035.ogg",
      "durationSec": 4.056
    },
    {
      "index": 36,
      "text": "再次感受一下房間。",
      "file": "c036.ogg",
      "durationSec": 4.296
    },
    {
      "index": 37,
      "text": "擺動手指和腳趾。",
      "file": "c037.ogg",
      "durationSec": 4.44
    },
    {
      "index": 38,
      "text": "準備好後，睜開眼睛。",
      "file": "c038.ogg",
      "durationSec": 5.304
    },
    {
      "index": 39,
      "text": "慢慢地進入接下來的事情。",
      "file": "c039.ogg",
      "durationSec": 5.04
    }
  ]
}
